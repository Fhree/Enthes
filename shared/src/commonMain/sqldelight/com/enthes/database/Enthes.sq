CREATE TABLE daily_checkins (
    id TEXT PRIMARY KEY NOT NULL,
    entry_date TEXT UNIQUE NOT NULL,
    morning_stiffness_minutes INTEGER,
    global_pain_level INTEGER NOT NULL,
    fatigue_level INTEGER,
    has_active_flare INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL
);

-- Returns full list shorted by date asc
selectAllCheckins:
SELECT *
FROM daily_checkins
ORDER BY entry_date DESC;

-- Add new daily data
insertCheckin:
INSERT INTO daily_checkins (
    id,
    entry_date,
    morning_stiffness_minutes,
    global_pain_level,
    fatigue_level,
    has_active_flare,
    created_at
) VALUES (?, ?, ?, ?, ?, ?, ?);