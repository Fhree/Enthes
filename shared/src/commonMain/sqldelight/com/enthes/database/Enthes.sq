CREATE TABLE historic_disease_activity (
    id TEXT PRIMARY KEY NOT NULL,
    entry_date TEXT UNIQUE NOT NULL,
    morning_stiffness_minutes INTEGER,
    global_pain_level INTEGER NOT NULL,
    fatigue_level INTEGER,
    has_active_flare INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    pain_zones TEXT NOT NULL DEFAULT ''
);

-- Returns full list sorted by date DESC
selectAllDiseaseActivities:
SELECT *
FROM historic_disease_activity
ORDER BY entry_date DESC;

-- Returns a single daily record by id
selectById:
SELECT *
FROM historic_disease_activity
WHERE id = ?;

-- Add new daily data
insertDiseaseActivity:
INSERT INTO historic_disease_activity (
    id,
    entry_date,
    morning_stiffness_minutes,
    global_pain_level,
    fatigue_level,
    has_active_flare,
    created_at,
    pain_zones
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

-- Delete a daily record by id
deleteById:
DELETE FROM historic_disease_activity
WHERE id = ?;

-- Update an existing daily record by id
updateActivity:
UPDATE historic_disease_activity
SET entry_date = ?,
    morning_stiffness_minutes = ?,
    global_pain_level = ?,
    fatigue_level = ?,
    has_active_flare = ?,
    pain_zones = ?
WHERE id = ?;
